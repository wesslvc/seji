<?xml version="1.0" encoding="UTF-8"?>
<!-- 세계지리 지엽개념 정리 — tools/restructure-codex.py 가 만든다.
     내용은 사용자가 쓴 정리본 그대로이고, 뼈대(대단원·묶음·정의표)만 다시 짰다. -->
<codex title="세계지리 지엽개념" v="2" status="draft">
  <part id="region" title="지역과 문화" desc="권역·문명·지역화 전략처럼 자리를 외워 두는 것들">
    <section n="1" title="구소련 국가들(15개국)">
      <li>발트3국, 캅카스3국, 중앙아시아 5개국, 러시아, 우크라이나, 벨라루스, 몰도바</li>
      <q>
        <ask>구소련을 이루던 15개 공화국을 모두 고르시오.</ask>
        <opt ok="1">몰도바</opt>
        <opt ok="1">조지아</opt>
        <opt ok="1">투르크메니스탄</opt>
        <opt ok="1">리투아니아</opt>
        <opt>루마니아</opt>
        <opt>폴란드</opt>
        <opt>몽골</opt>
        <opt>핀란드</opt>
        <why>루마니아·폴란드·몽골은 소련 밖의 위성국, 핀란드는 독립을 지켰다. 몰도바는 루마니아와 말이 같지만 소련 공화국이었다.</why>
      </q>
      <q>
        <ask>러시아와 국경을 맞댄 구소련 국가를 모두 고르시오.</ask>
        <opt ok="1">에스토니아</opt>
        <opt ok="1">리투아니아</opt>
        <opt ok="1">아제르바이잔</opt>
        <opt ok="1">카자흐스탄</opt>
        <opt>아르메니아</opt>
        <opt>몰도바</opt>
        <opt>우즈베키스탄</opt>
        <opt>키르기스스탄</opt>
        <why>리투아니아는 러시아 월경지 칼리닌그라드와 맞닿는다. 아르메니아는 조지아에, 몰도바는 우크라이나에, 우즈베키스탄·키르기스스탄은 카자흐스탄에 막혀 있다.</why>
      </q>
      <q>
        <ask>바다에 닿지 않는 구소련 국가를 모두 고르시오.</ask>
        <opt ok="1">몰도바</opt>
        <opt ok="1">벨라루스</opt>
        <opt ok="1">아르메니아</opt>
        <opt ok="1">우즈베키스탄</opt>
        <opt>조지아</opt>
        <opt>우크라이나</opt>
        <opt>라트비아</opt>
        <opt>에스토니아</opt>
        <why>조지아·우크라이나는 흑해, 라트비아·에스토니아는 발트해에 닿는다. 우즈베키스탄은 이웃도 모두 내륙국인 이중 내륙국이다.</why>
      </q>
      <q>
        <ask>이슬람교가 다수인 구소련 국가를 모두 고르시오.</ask>
        <opt ok="1">아제르바이잔</opt>
        <opt ok="1">카자흐스탄</opt>
        <opt ok="1">우즈베키스탄</opt>
        <opt ok="1">타지키스탄</opt>
        <opt>조지아</opt>
        <opt>아르메니아</opt>
        <opt>벨라루스</opt>
        <opt>몰도바</opt>
        <why>캅카스 3국 가운데 아제르바이잔만 이슬람(시아파)이다. 조지아는 정교회, 아르메니아는 아르메니아 사도 교회.</why>
      </q>
      <q>
        <ask>튀르크계 언어를 국어로 쓰는 구소련 국가를 모두 고르시오.</ask>
        <opt ok="1">아제르바이잔</opt>
        <opt ok="1">키르기스스탄</opt>
        <opt ok="1">투르크메니스탄</opt>
        <opt>타지키스탄</opt>
        <opt>아르메니아</opt>
        <opt>조지아</opt>
        <why>중앙아시아 5개국 가운데 타지키스탄만 페르시아계(타지크어)다. 아제르바이잔어는 튀르키예어와 가깝다.</why>
      </q>
    </section>
    <section n="2" title="인도네시아의 종교명소">
      <d k="자바섬" v="보로부두르 사원 (불교)"/>
      <d k="발리섬" v="힌두교"/>
      <q>
        <ask>인도네시아의 종교에 대한 설명으로 옳은 것을 모두 고르시오.</ask>
        <opt ok="1">세계에서 무슬림 인구가 가장 많은 나라다</opt>
        <opt ok="1">발리섬은 힌두교가 다수다</opt>
        <opt ok="1">보로부두르 사원은 불교 유적이다</opt>
        <opt>보로부두르 사원은 발리섬에 있다</opt>
        <opt>프람바난 사원은 이슬람 사원이다</opt>
        <opt>수마트라섬 북단 아체주는 힌두교가 다수다</opt>
        <why>보로부두르(불교)와 프람바난(힌두교)은 모두 자바섬에 있다. 아체는 이슬람 율법을 가장 엄격히 따르는 주다.</why>
      </q>
    </section>
    <section n="3" title="중남미 문명">
      <d k="마야" v="멕시코 남부(치아파스 주 이남) ~ 온두라스 &amp; 엘살바도르"/>
      <d k="아즈텍" v="멕시코 중부(멕시코시티 – 당시 테노치티틀란)"/>
      <d k="잉카" v="페루(수도 쿠스코), 에콰도르, 볼리비아 칠레 북부, 콜롬비아남부, 아르헨티나 북서부 등"/>
      <figure src="img/codex/image1.webp" caption="마야·아즈텍·잉카 문명의 분포"/>
      <q>
        <ask>잉카 문명에 대한 설명으로 옳은 것을 모두 고르시오.</ask>
        <opt ok="1">수도는 쿠스코였다</opt>
        <opt ok="1">안데스 산지를 따라 남북으로 길게 뻗었다</opt>
        <opt ok="1">마추픽추는 잉카의 유적이다</opt>
        <opt>수도는 호수 위의 도시 테노치티틀란이었다</opt>
        <opt>유카탄반도의 열대 저지대가 중심이었다</opt>
        <opt>치첸이트사는 잉카의 유적이다</opt>
        <why>테노치티틀란은 아즈텍, 유카탄반도와 치첸이트사는 마야.</why>
      </q>
      <q>
        <ask>잉카 제국의 영역에 들었던 오늘날의 나라를 모두 고르시오.</ask>
        <opt ok="1">에콰도르</opt>
        <opt ok="1">볼리비아</opt>
        <opt ok="1">칠레</opt>
        <opt ok="1">아르헨티나</opt>
        <opt>브라질</opt>
        <opt>파라과이</opt>
        <opt>베네수엘라</opt>
        <opt>과테말라</opt>
        <why>페루를 중심으로 에콰도르·볼리비아·칠레 북부·아르헨티나 북서부·콜롬비아 남부까지. 안데스 동쪽 저지대(브라질·파라과이)로는 내려가지 않았다.</why>
      </q>
      <q>
        <ask>마야 문명의 영역에 들었던 오늘날의 나라를 모두 고르시오.</ask>
        <opt ok="1">과테말라</opt>
        <opt ok="1">벨리즈</opt>
        <opt ok="1">온두라스</opt>
        <opt ok="1">멕시코</opt>
        <opt>페루</opt>
        <opt>에콰도르</opt>
        <opt>볼리비아</opt>
        <opt>파나마</opt>
        <why>멕시코 남부(치아파스·유카탄)부터 과테말라·벨리즈·온두라스·엘살바도르까지.</why>
      </q>
    </section>
    <section n="4" title="지역화 전략들">
      <d k="지리적표시제" v="지적재산권"/>
      <d k="장소마케팅" v="축제 (태국 송끄란 -&gt; 건기끝나는시기에)"/>
      <d k="지역브랜드화" v="상표"/>
      <q>
        <ask>지리적 표시제의 사례를 모두 고르시오.</ask>
        <opt ok="1">보성 녹차</opt>
        <opt ok="1">프랑스 샴페인</opt>
        <opt ok="1">이탈리아 파르미지아노 레자노 치즈</opt>
        <opt>태국 송끄란 축제</opt>
        <opt>함평 나비 축제</opt>
        <opt>‘I ♥ NY’ 로고</opt>
        <why>지리적 표시제는 그 땅에서 난 상품의 이름을 지식재산권으로 지킨다. 축제는 장소 마케팅, 로고는 지역 브랜드화.</why>
      </q>
      <q>
        <ask>장소 마케팅의 사례를 모두 고르시오.</ask>
        <opt ok="1">태국 송끄란 축제</opt>
        <opt ok="1">함평 나비 축제</opt>
        <opt ok="1">브라질 리우 카니발</opt>
        <opt ok="1">스페인 라 토마티나</opt>
        <opt>보성 녹차 명칭 보호</opt>
        <opt>샴페인 명칭 보호</opt>
        <opt>카망베르 치즈 원산지 인증</opt>
        <why>축제·행사로 장소 자체를 알려 사람을 모은다. 상품 이름을 보호하는 것은 지리적 표시제.</why>
      </q>
    </section>
  </part>
  <part id="map" title="지도와 지리 정보" desc="고지도 계보, 지리 정보의 종류와 수집 방법">
    <section n="5" title="서양의 고지도">
      <group title="프톨레마이오스 지도 (AD)" i="1">
        <li>지구가 구체임을 인식(경위선 사용)</li>
        <li>원뿔도법</li>
        <li>인도양 내해(內海)로 표현함(수특에도 있는 내용)</li>
        <figure src="img/codex/image2.webp" caption="프톨레마이오스 세계지도"/>
      </group>
      <group title="TO지도" i="2">
        <li>아시아 아프리카 경계는 홍해</li>
        <li>유럽 아프리카 경계는 지중해</li>
        <li>아시아 유럽 경계는 타나이스(돈강)</li>
        <note>(돈강은 모스크바, 우크라이나 일대를 지난다)</note>
        <figure src="img/codex/image3.webp" caption="TO 지도"/>
      </group>
      <group title="마파문디" i="3">
        <figure src="img/codex/image4.webp" caption="마파문디"/>
      </group>
      <group title="알 이드리시 세계지도" i="4">
        <li>메카를 중심에 둠 (그러려고 뒤집음)</li>
        <li>지구를 구체로 인식 (등기후선을 곡선으로 그림)</li>
        <figure src="img/codex/image5.webp" caption="알 이드리시 세계지도"/>
      </group>
      <group title="포르톨라노 해도海圖" i="5">
        <li>향해용 지도</li>
        <li>항구와 섬을 자세히 표현</li>
        <li>나침반에서 여러개의 방사선 -&gt; 항로파악</li>
        <figure src="img/codex/image6.webp" caption="포르톨라노 해도"/>
      </group>
      <group title="메르카토르" i="6">
        <li>신대륙 그려져있음</li>
        <d k="원통 도법" v="방위가 정확함"/>
        <d k="직선" v="등각항로(최단거리X)"/>
        <li>고위도로 갈수록 면적확대</li>
        <note>면적 확대의 이유는 실제로 위도가 올라갈수록 경선간 간격이 감소하는데 북극점, 남극점을 중심으로 펼치다보니 경산간 간격이 적도부터 고위도까지 모두 일치하게 되었기에 왜곡이 발생함</note>
        <figure src="img/codex/image7.webp" caption="메르카토르 세계지도 (1569)"/>
      </group>
      <q>
        <ask>프톨레마이오스 세계지도에 대한 설명으로 옳은 것을 모두 고르시오.</ask>
        <opt ok="1">경위선을 사용했다</opt>
        <opt ok="1">원뿔 도법으로 그렸다</opt>
        <opt ok="1">인도양을 육지로 둘러싸인 내해로 그렸다</opt>
        <opt>아메리카 대륙이 그려져 있다</opt>
        <opt>메카를 가운데 두었다</opt>
        <opt>남쪽을 위로 두었다</opt>
        <why>2세기 지도라 아메리카는 없다. 메카 중심·남쪽이 위인 것은 알 이드리시.</why>
      </q>
      <q>
        <ask>TO 지도에 대한 설명으로 옳은 것을 모두 고르시오.</ask>
        <opt ok="1">지중해가 유럽과 아프리카를 가른다</opt>
        <opt ok="1">돈강(타나이스강)이 유럽과 아시아를 가른다</opt>
        <opt ok="1">동쪽(아시아)을 위에 두었다</opt>
        <opt ok="1">예루살렘을 가운데 두었다</opt>
        <opt>경위선을 사용했다</opt>
        <opt>아메리카 대륙이 그려져 있다</opt>
        <opt>지구를 구체로 그렸다</opt>
        <why>크리스트교 세계관의 상징도다. 둥근 땅(O)을 물줄기(T)가 셋으로 가르고, 해 뜨는 동쪽(낙원)을 위에 둔다.</why>
      </q>
      <q>
        <ask>알 이드리시 세계지도에 대한 설명으로 옳은 것을 모두 고르시오.</ask>
        <opt ok="1">남쪽을 위로 두었다</opt>
        <opt ok="1">메카를 가운데 두었다</opt>
        <opt ok="1">지구를 구체로 인식했다</opt>
        <opt>예루살렘을 가운데 두었다</opt>
        <opt>나침반 방사선으로 항로를 그렸다</opt>
        <opt>아메리카 대륙이 그려져 있다</opt>
        <why>12세기 이슬람 지도. 예루살렘 중심은 TO 지도, 나침반 방사선은 포르톨라노 해도.</why>
      </q>
      <q>
        <ask>메르카토르 세계지도에 대한 설명으로 옳은 것을 모두 고르시오.</ask>
        <opt ok="1">방위가 정확해 항해에 쓰였다</opt>
        <opt ok="1">지도 위 직선은 등각 항로다</opt>
        <opt ok="1">고위도로 갈수록 면적이 커진다</opt>
        <opt ok="1">아메리카 대륙이 그려져 있다</opt>
        <opt>지도 위 직선이 최단 거리다</opt>
        <opt>원뿔 도법으로 그렸다</opt>
        <opt>면적이 정확해 분포도에 알맞다</opt>
        <why>원통 도법이라 경선이 평행하게 펴져 고위도가 부푼다. 최단 거리(대권 항로)는 이 지도에서 곡선으로 나타난다.</why>
      </q>
      <q>
        <ask>지구를 둥근 구체로 인식하고 그린 지도를 모두 고르시오.</ask>
        <opt ok="1">프톨레마이오스 세계지도</opt>
        <opt ok="1">알 이드리시 세계지도</opt>
        <opt ok="1">지구전후도</opt>
        <opt ok="1">곤여만국전도</opt>
        <opt>TO 지도</opt>
        <opt>천하도</opt>
        <opt>화이도</opt>
        <opt>대명혼일도</opt>
        <why>TO 지도는 종교적 상징도, 천하도·화이도·대명혼일도는 천원지방(땅은 네모)을 따른다.</why>
      </q>
    </section>
    <section n="6" title="우리나라의 고지도">
      <group title="혼일강리역대국도지도 (1402)" i="1">
        <li>중화사상 반영</li>
        <li>구대륙 ∀반영</li>
        <li>천원지방</li>
        <note>대명혼일도와 굳이 구분하자면 한자의 길이, 우리나라의 크기로 구분가능</note>
        <note>대명혼일도와 굳이 구분하자면22 대명혼일도가 먼저임</note>
        <figure src="img/codex/image8.webp" caption="혼일강리역대국도지도 (1402)"/>
      </group>
      <group title="천하도 (조선 중기)" i="2">
        <li>민간에서 제작</li>
        <li>중화사상</li>
        <li>내대륙 현실 / 외대륙 상상 (=&gt; 도교사상반영)</li>
        <li>천원지방</li>
        <figure src="img/codex/image9.webp" caption="천하도"/>
      </group>
      <group title="지구전후도" i="3">
        <li>민간에서 제작</li>
        <li>중화사상 &amp; 천원지방X</li>
        <li>지구를 구체로 인식 (경위선, 회귀선O)</li>
        <d k="목판본" v="대량생산"/>
        <figure src="img/codex/image10.webp" caption="지구전후도"/>
      </group>
      <q>
        <ask>혼일강리역대국도지도에 대한 설명으로 옳은 것을 모두 고르시오.</ask>
        <opt ok="1">1402년 조선에서 만들었다</opt>
        <opt ok="1">중화사상이 반영되었다</opt>
        <opt ok="1">아시아·유럽·아프리카 구대륙을 담았다</opt>
        <opt>아메리카 대륙이 그려져 있다</opt>
        <opt>목판으로 찍어 대량 생산했다</opt>
        <opt>민간에서 제작했다</opt>
        <opt>지구를 구체로 인식했다</opt>
        <why>조정에서 만든 필사본이다. 목판 대량 생산은 지구전후도, 민간 제작은 천하도·지구전후도.</why>
      </q>
      <q>
        <ask>천하도에 대한 설명으로 옳은 것을 모두 고르시오.</ask>
        <opt ok="1">민간에서 제작했다</opt>
        <opt ok="1">가운데는 실제 대륙, 바깥은 상상의 대륙이다</opt>
        <opt ok="1">도교적 세계관이 반영되었다</opt>
        <opt ok="1">천원지방을 따른다</opt>
        <opt>경위선과 회귀선을 그렸다</opt>
        <opt>마테오 리치가 제작에 참여했다</opt>
        <opt>태평양을 가운데 두었다</opt>
        <why>경위선·회귀선은 지구전후도, 마테오 리치와 태평양 중심은 곤여만국전도.</why>
      </q>
      <q>
        <ask>지구전후도에 대한 설명으로 옳은 것을 모두 고르시오.</ask>
        <opt ok="1">경위선과 회귀선을 그렸다</opt>
        <opt ok="1">목판본이라 대량으로 찍어 냈다</opt>
        <opt ok="1">지구를 구체로 인식했다</opt>
        <opt>천원지방을 따른다</opt>
        <opt>중화사상이 반영되었다</opt>
        <opt>15세기 초에 제작되었다</opt>
        <why>19세기 최한기가 만들고 김정호가 판각했다. 천원지방과 중화사상에서 벗어났다.</why>
      </q>
    </section>
    <section n="7" title="중국의 고지도">
      <group title="화이도 (송나라 12세기)" i="1">
        <li>중국 전체가 표현된 현존 가장 오래된 지도</li>
        <li>천원지방</li>
        <li>중화사상 (중국 확대, 타 지역 축소)</li>
        <figure src="img/codex/image11.webp" caption="화이도"/>
      </group>
      <group title="대명혼일도 (14세기 末)" i="2">
        <li>천원지방</li>
        <li>중화사상</li>
        <figure src="img/codex/image12.webp" caption="대명혼일도"/>
      </group>
      <group title="곤여만국전도 (17세기 초)" i="3">
        <li>마테오리치(ITA) + 明 학자</li>
        <li>태평양을 중앙에 배치</li>
        <li>중화사상 &amp; 천원지방 OUT</li>
        <li>지구를 구체로 인식</li>
        <figure src="img/codex/image13.webp" caption="곤여만국전도"/>
      </group>
      <q>
        <ask>중화사상이 반영된 지도를 모두 고르시오.</ask>
        <opt ok="1">화이도</opt>
        <opt ok="1">대명혼일도</opt>
        <opt ok="1">혼일강리역대국도지도</opt>
        <opt ok="1">천하도</opt>
        <opt>곤여만국전도</opt>
        <opt>지구전후도</opt>
        <opt>메르카토르 세계지도</opt>
        <why>곤여만국전도와 지구전후도는 지구를 구체로 그리며 중국 중심에서 벗어났다.</why>
      </q>
      <q>
        <ask>곤여만국전도에 대한 설명으로 옳은 것을 모두 고르시오.</ask>
        <opt ok="1">마테오 리치가 명나라 학자들과 만들었다</opt>
        <opt ok="1">태평양을 가운데 두었다</opt>
        <opt ok="1">지구를 구체로 인식했다</opt>
        <opt>천원지방을 따른다</opt>
        <opt>송나라 때 만들었다</opt>
        <opt>14세기 말에 만들었다</opt>
        <why>17세기 초(1602) 명나라. 송나라는 화이도, 14세기 말은 대명혼일도.</why>
      </q>
      <q>
        <ask>혼일강리역대국도지도보다 먼저 만들어진 지도를 모두 고르시오.</ask>
        <opt ok="1">화이도</opt>
        <opt ok="1">대명혼일도</opt>
        <opt ok="1">프톨레마이오스 세계지도</opt>
        <opt ok="1">TO 지도</opt>
        <opt>곤여만국전도</opt>
        <opt>메르카토르 세계지도</opt>
        <opt>지구전후도</opt>
        <opt>천하도</opt>
        <why>화이도 12세기, 대명혼일도 14세기 말, 프톨레마이오스 2세기, TO 지도 중세 초. 메르카토르 1569, 곤여만국전도 1602, 천하도 조선 중기, 지구전후도 19세기.</why>
      </q>
    </section>
    <section n="8" title="지리정보">
      <d k="공간정보" v="수리적 위치 &amp; 모양"/>
      <d k="관계정보" v="다른 장소의 이름과 함께 제시됨(수교 등)"/>
      <d k="속성" v="(공간U관계)^c"/>
      <q>
        <ask>속성 정보에 해당하는 것을 모두 고르시오.</ask>
        <opt ok="1">인구는 950만 명이다</opt>
        <opt ok="1">연평균 기온은 12.5℃이다</opt>
        <opt ok="1">주민 대다수가 이슬람교를 믿는다</opt>
        <opt>북위 37.5°, 동경 127°에 있다</opt>
        <opt>남쪽으로 B국과 국경을 맞댄다</opt>
        <opt>최대 교역 상대국은 C국이다</opt>
        <why>장소의 성질은 속성, 위치·모양은 공간, 다른 장소와의 연결은 관계 정보.</why>
      </q>
      <q>
        <ask>관계 정보에 해당하는 것을 모두 고르시오.</ask>
        <opt ok="1">남쪽으로 B국과 국경을 맞댄다</opt>
        <opt ok="1">최대 교역 상대국은 C국이다</opt>
        <opt ok="1">D국과 1992년에 수교했다</opt>
        <opt>북위 37.5°, 동경 127°에 있다</opt>
        <opt>인구는 950만 명이다</opt>
        <opt>해발 고도는 38m이다</opt>
        <why>다른 장소의 이름과 함께 제시되면 관계 정보다.</why>
      </q>
    </section>
    <section n="12" title="지리정보 수집방법">
      <d k="직접조사" v="가서"/>
      <d k="원격조사" v="위성이나 드론으로"/>
      <d k="간접조사" v="인터넷, 문헌"/>
      <q>
        <ask>인공위성 원격 탐사로 조사하기에 알맞은 것을 모두 고르시오.</ask>
        <opt ok="1">열대림 벌채 면적의 변화</opt>
        <opt ok="1">빙하 면적의 변화</opt>
        <opt ok="1">대형 산불의 피해 범위</opt>
        <opt>주민이 믿는 종교</opt>
        <opt>시장 상인의 하루 매출</opt>
        <opt>옛 지명의 유래</opt>
        <why>넓은 지역을 같은 시각에 되풀이해 보는 데 강하다. 사람의 생각·기록은 직접·간접 조사로.</why>
      </q>
    </section>
    <section n="13" title="GPS VS GIS">
      <d k="GPS" v="Global Positioning System =&gt; 위치정보 수집"/>
      <d k="GIS" v="Geographic Information System =&gt; 분석 &amp; 시각화"/>
      <q>
        <ask>GIS(지리 정보 체계)로 하는 일을 모두 고르시오.</ask>
        <opt ok="1">여러 주제도를 겹쳐 입지를 고른다</opt>
        <opt ok="1">도로에서 일정 거리 안의 지역을 뽑아낸다</opt>
        <opt ok="1">분석 결과를 지도로 시각화한다</opt>
        <opt>위성 신호를 받아 현재 위치를 잰다</opt>
        <opt>현장에 가서 주민을 면담한다</opt>
        <why>위치를 재는 것은 GPS. GIS 는 모은 정보를 겹치고 분석하고 보여 준다.</why>
      </q>
    </section>
    <section n="14" title="권역구분">
      <d k="자연적지표" v="기후, 식생, 토양, 지표, 자연 등"/>
      <d k="문화적 지표" v="언어, 종교, 음식 등 (애매하고 복잡)"/>
      <d k="기능적 지표" v="행정권, 생활권, 교통권 등 (ex 수도권)"/>
      <q>
        <ask>기능적 지표로 나눈 권역을 모두 고르시오.</ask>
        <opt ok="1">수도권</opt>
        <opt ok="1">대도시의 통근권</opt>
        <opt ok="1">백화점의 상권</opt>
        <opt>몬순 아시아</opt>
        <opt>이슬람 문화권</opt>
        <opt>열대 기후 지역</opt>
        <why>중심지와 이어진 기능으로 묶으면 기능 지역. 몬순·열대는 자연적, 이슬람은 문화적 지표.</why>
      </q>
    </section>
  </part>
  <part id="coord" title="위치와 시간" desc="위선·경선·시차, 그리고 태양 고도가 만드는 낮과 밤">
    <section n="9" title="시차 계산">
      <d k="동경" v="GMT + -&gt; 시간 빠름"/>
      <d k="서경" v="GMT - -&gt; 시간 느림"/>
      <li c="1">15°당 1시간</li>
      <q>
        <ask>서울이 1월 1일 오전 9시일 때, 아직 12월 31일인 도시를 모두 고르시오.</ask>
        <opt ok="1">뉴욕</opt>
        <opt ok="1">로스앤젤레스</opt>
        <opt ok="1">호놀룰루</opt>
        <opt ok="1">리우데자네이루</opt>
        <opt>런던</opt>
        <opt>모스크바</opt>
        <opt>베이징</opt>
        <why>런던은 9시간 늦은 1월 1일 0시. 리우는 12시간 늦은 12월 31일 21시, 뉴욕은 14시간 늦은 19시.</why>
      </q>
      <q>
        <ask>서울과의 시차가 10시간 이상인 도시를 모두 고르시오.</ask>
        <opt ok="1">뉴욕</opt>
        <opt ok="1">로스앤젤레스</opt>
        <opt ok="1">리우데자네이루</opt>
        <opt>런던</opt>
        <opt>모스크바</opt>
        <opt>카이로</opt>
        <opt>시드니</opt>
        <why>15°에 1시간. 런던 9, 모스크바 6, 카이로 7, 시드니 1시간 / 리우 12, 뉴욕 14, 로스앤젤레스 17시간.</why>
      </q>
      <q>
        <ask>로스앤젤레스가 3일 오후 2시일 때, 이미 4일인 도시를 모두 고르시오.</ask>
        <opt ok="1">베이징</opt>
        <opt ok="1">모스크바</opt>
        <opt ok="1">두바이</opt>
        <opt>런던</opt>
        <opt>뉴욕</opt>
        <opt>리우데자네이루</opt>
        <why>로스앤젤레스보다 모스크바 11시간(4일 1시), 두바이 12시간(4일 2시), 베이징 16시간(4일 6시) 빠르다. 런던은 3일 22시.</why>
      </q>
    </section>
    <section n="10" title="주요 위선">
      <d k="0°" v="적도기니 케냐 싱가포르 에콰도르"/>
      <note>사실 적도기니는 적도보다 아주 살짝 북쪽에 있어 지나지 않음 즉 가봉과 DRC가 적도를 지나는 것</note>
      <d k="23.5°N" v="서사하라, UAE, 대만, 캘리포니아반도 끝"/>
      <d k="23.5°S" v="나미비아, 호주관통, 남미 접선"/>
      <q>
        <ask>적도가 지나는 나라를 모두 고르시오.</ask>
        <opt ok="1">가봉</opt>
        <opt ok="1">케냐</opt>
        <opt ok="1">우간다</opt>
        <opt ok="1">인도네시아</opt>
        <opt>적도기니</opt>
        <opt>탄자니아</opt>
        <opt>카메룬</opt>
        <opt>말레이시아</opt>
        <why>적도기니는 본토가 적도보다 살짝 북쪽이다. 탄자니아는 빅토리아호 남쪽이라 적도 아래, 말레이시아는 1°N 위.</why>
      </q>
      <q>
        <ask>북회귀선이 지나는 나라를 모두 고르시오.</ask>
        <opt ok="1">대만</opt>
        <opt ok="1">방글라데시</opt>
        <opt ok="1">이집트</opt>
        <opt ok="1">멕시코</opt>
        <opt>쿠바</opt>
        <opt>필리핀</opt>
        <opt>태국</opt>
        <opt>스리랑카</opt>
        <why>쿠바는 북회귀선 바로 남쪽(아바나 23.1°N)에서 멈춘다. 서쪽으로는 UAE·오만·사우디·서사하라를 지난다.</why>
      </q>
      <q>
        <ask>남회귀선이 지나는 나라를 모두 고르시오.</ask>
        <opt ok="1">보츠와나</opt>
        <opt ok="1">마다가스카르</opt>
        <opt ok="1">모잠비크</opt>
        <opt ok="1">파라과이</opt>
        <opt>짐바브웨</opt>
        <opt>앙골라</opt>
        <opt>우루과이</opt>
        <opt>페루</opt>
        <why>아프리카는 나미비아·보츠와나·남아공·모잠비크·마다가스카르, 남아메리카는 칠레·아르헨티나·파라과이·브라질.</why>
      </q>
    </section>
    <section n="11" title="주요 경선">
      <d k="120°W" v="LA, SF"/>
      <d k="75°W" v="NY, DC"/>
      <d k="0°" v="영국 &amp; 기니만"/>
      <d k="75°E" v="인도관통"/>
      <d k="120°E" v="북경, 호주서부"/>
      <q>
        <ask>본초 자오선이 지나는 나라를 모두 고르시오.</ask>
        <opt ok="1">프랑스</opt>
        <opt ok="1">스페인</opt>
        <opt ok="1">말리</opt>
        <opt ok="1">가나</opt>
        <opt>포르투갈</opt>
        <opt>모로코</opt>
        <opt>나이지리아</opt>
        <opt>코트디부아르</opt>
        <why>영국–프랑스–스페인–알제리–말리–부르키나파소–토고–가나. 포르투갈·모로코·코트디부아르는 서쪽, 나이지리아는 동쪽.</why>
      </q>
      <q>
        <ask>120°E 경선이 지나는 나라를 모두 고르시오.</ask>
        <opt ok="1">중국</opt>
        <opt ok="1">필리핀</opt>
        <opt ok="1">인도네시아</opt>
        <opt ok="1">오스트레일리아</opt>
        <opt>대한민국</opt>
        <opt>일본</opt>
        <opt>베트남</opt>
        <opt>태국</opt>
        <why>120°E 는 베이징 동쪽–루손섬–술라웨시섬–오스트레일리아 서부. 우리나라는 124~132°E, 베트남은 102~110°E.</why>
      </q>
    </section>
    <section n="18" title="정오의 태양고도각">
      <li>태양 고도각이 90도인 지점으로부터 거리에 반비례</li>
      <q>
        <ask>북반구 하짓날 정오, 태양 고도가 서울보다 높은 곳을 모두 고르시오.</ask>
        <opt ok="1">북회귀선 위의 한 지점</opt>
        <opt ok="1">타이베이</opt>
        <opt ok="1">도쿄</opt>
        <opt>적도 위의 한 지점</opt>
        <opt>싱가포르</opt>
        <opt>베이징</opt>
        <why>하지에 태양은 23.5°N 머리 위. 거기서 멀수록 낮다 — 적도는 23.5° 떨어져 66.5°로 서울(14° 떨어짐)보다 낮다.</why>
      </q>
      <q>
        <ask>12월 동짓날 정오, 태양이 북쪽 하늘에 뜨는 곳을 모두 고르시오.</ask>
        <opt ok="1">시드니</opt>
        <opt ok="1">케이프타운</opt>
        <opt ok="1">부에노스아이레스</opt>
        <opt>싱가포르</opt>
        <opt>나이로비</opt>
        <opt>리우데자네이루</opt>
        <why>동지에 태양은 23.5°S 머리 위. 그보다 남쪽에서만 북쪽 하늘에 뜬다. 리우는 23.5°S 보다 살짝 북쪽이라 남쪽 하늘.</why>
      </q>
      <q>
        <ask>춘분날 정오의 태양 고도에 대한 설명으로 옳은 것을 모두 고르시오.</ask>
        <opt ok="1">적도에서 90°이다</opt>
        <opt ok="1">서울에서 52.5°이다</opt>
        <opt ok="1">남위 37.5°에서도 52.5°이다</opt>
        <opt>북회귀선에서 90°이다</opt>
        <opt>서울보다 적도에서 낮다</opt>
        <opt>북극점에서 23.5°이다</opt>
        <why>춘분에 태양은 적도 위. 고도 = 90° − 위도라 남·북이 대칭이고, 극점에서는 지평선(0°)에 걸린다.</why>
      </q>
    </section>
    <section n="19" title="백야와 극야">
      <li>부분 백/극야 (48~66.5도) - 박명(Twilight)이 이어져 초저녁같음</li>
      <li>백/극야 (66.5도↑) - 자정에도 태양이 수평선보다 높게 떠있음</li>
      <q>
        <ask>하짓날 자정에도 해가 지지 않는 백야를 볼 수 있는 곳을 모두 고르시오.</ask>
        <opt ok="1">트롬쇠</opt>
        <opt ok="1">무르만스크</opt>
        <opt ok="1">롱위에아르뷔엔</opt>
        <opt>레이캬비크</opt>
        <opt>상트페테르부르크</opt>
        <opt>헬싱키</opt>
        <why>66.5° 이상(극권)에서만 진짜 백야. 레이캬비크·상트페테르부르크는 해가 잠깐 지고 박명만 밤새 이어지는 부분 백야.</why>
      </q>
    </section>
    <section n="20" title="낮길이">
      <d k="하지" v="90°N = 24시간 -&gt; 90°S 0시간"/>
      <d k="동지" v="90°S = 24시간 / 90°N 0시간"/>
      <d k="춘/추분" v="전지구 낮길이 동일(12시간)"/>
      <q>
        <ask>북반구 하짓날에 대한 설명으로 옳은 것을 모두 고르시오.</ask>
        <opt ok="1">북극점은 24시간 낮이다</opt>
        <opt ok="1">남극점은 24시간 밤이다</opt>
        <opt ok="1">적도의 낮 길이는 약 12시간이다</opt>
        <opt>남반구는 낮이 밤보다 길다</opt>
        <opt>태양은 남회귀선 위에 있다</opt>
        <opt>서울은 낮이 가장 짧다</opt>
        <why>하지에 태양은 북회귀선 위. 북쪽으로 갈수록 낮이 길고, 적도는 연중 12시간 안팎.</why>
      </q>
      <q>
        <ask>3월 춘분에 대한 설명으로 옳은 것을 모두 고르시오.</ask>
        <opt ok="1">전 세계의 낮 길이가 약 12시간이다</opt>
        <opt ok="1">태양이 적도 위에 있다</opt>
        <opt ok="1">남반구에서는 가을이 시작된다</opt>
        <opt>북극점은 24시간 낮이다</opt>
        <opt>남반구에서는 봄이 시작된다</opt>
        <opt>남극점은 24시간 밤이다</opt>
        <why>남반구는 계절이 반대라 3월 춘분이 가을의 시작이다. 극점에서는 해가 지평선에 걸려 돈다.</why>
      </q>
    </section>
  </part>
  <part id="climate" title="기후" desc="기후 요소부터 쾨펜 구분, 기후별 농업·식생·토양·가옥까지">
    <section n="15" title="계절풍">
      <d k="원리" v="대륙 &amp; 해양의 비열차로 바생"/>
      <d k="여름" v="남서풍 / 겨울 : 북동풍 (남아시아 기준)"/>
      <q>
        <ask>계절풍에 대한 설명으로 옳은 것을 모두 고르시오.</ask>
        <opt ok="1">대륙과 해양의 비열 차이로 생긴다</opt>
        <opt ok="1">여름 남아시아에서는 남서풍이 분다</opt>
        <opt ok="1">겨울 남아시아에서는 북동풍이 분다</opt>
        <opt>여름에는 대륙에 고기압이 생긴다</opt>
        <opt>겨울 남아시아는 우기다</opt>
        <opt>지구 자전 때문에 계절마다 방향이 바뀐다</opt>
        <why>여름엔 달궈진 대륙이 저기압이 되어 바다에서 습한 바람(우기), 겨울엔 식은 대륙이 고기압이 되어 대륙에서 마른 바람(건기).</why>
      </q>
    </section>
    <section n="16" title="열대 이동성 저기압 명칭">
      <d k="태풍" v="동아시아"/>
      <d k="허리케인" v="북대서양 북동태평양"/>
      <d k="사이클론" v="남반구 + 인도양"/>
      <q>
        <ask>열대 저기압을 ‘사이클론’이라 부르는 바다를 모두 고르시오.</ask>
        <opt ok="1">벵골만</opt>
        <opt ok="1">아라비아해</opt>
        <opt ok="1">오스트레일리아 북부 해역</opt>
        <opt ok="1">마다가스카르 부근 인도양</opt>
        <opt>필리핀 동쪽 태평양</opt>
        <opt>멕시코만</opt>
        <opt>카리브해</opt>
        <why>인도양과 남반구는 사이클론, 북서태평양은 태풍, 북대서양(멕시코만·카리브해)·북동태평양은 허리케인.</why>
      </q>
      <q>
        <ask>열대 저기압에 대한 설명으로 옳은 것을 모두 고르시오.</ask>
        <opt ok="1">따뜻한 바다의 수증기에서 에너지를 얻는다</opt>
        <opt ok="1">적도 바로 근처에서는 거의 생기지 않는다</opt>
        <opt ok="1">육지에 오르면 급격히 약해진다</opt>
        <opt>북반구에서는 시계 방향으로 돈다</opt>
        <opt>한랭 전선과 온난 전선을 동반한다</opt>
        <opt>남대서양에서 자주 발생한다</opt>
        <why>북반구에서는 반시계 방향. 전선이 없는 것이 온대 저기압과 다른 점이다. 남대서양은 수온이 낮아 거의 생기지 않는다.</why>
      </q>
    </section>
    <section n="17" title="다우지 多雨地">
      <figure src="img/codex/image14.webp" caption="세계 연강수량"/>
      <group title="열대수렴대 지역 — Af · Am">
        <d k="최대강수" v="방글라데시 삼각주 북쪽 (아삼주, 메갈라야주 – 체라푼지 11000mm+)"/>
      </group>
      <group title="한대전선대 지역">
        <d k="노르웨이 서안" v="베르겐(Bergen) - 2250~2550mm"/>
        <d k="뉴질랜드 남서부 해안" v="밀포드 사운드(Milford Sound) - 6880mm"/>
        <d k="칠레 남부 해안" v="푸에트로 시스네스 (Puetro Cisnes) - 4336mm"/>
        <d k="캐나다 남서부 해안" v="밴쿠버(Vancouver) 후쿡툴리스 호수 – 6903mm"/>
      </group>
      <q>
        <ask>편서풍의 바람받이라서 비가 많은 곳을 모두 고르시오.</ask>
        <opt ok="1">노르웨이 서안</opt>
        <opt ok="1">칠레 남부 해안</opt>
        <opt ok="1">뉴질랜드 남섬 서부</opt>
        <opt ok="1">캐나다 남서부 해안</opt>
        <opt>아르헨티나 파타고니아</opt>
        <opt>인도 체라푼지</opt>
        <opt>아마존 분지</opt>
        <why>위도 40~60° 대륙 서안의 산지. 파타고니아는 같은 편서풍의 비그늘, 체라푼지는 계절풍, 아마존은 열대 수렴대.</why>
      </q>
    </section>
    <section n="21" title="쾨펜의 기후구분 (경계값)">
      <li>무수목 ↔ 수목 (연강수령 500+ &amp; 최난월기온 10+)</li>
      <d k="A열대" v="최한월 18+"/>
      <d k="B건조" v="연강수량 500-"/>
      <d k="C온대" v="최한월 -3~18"/>
      <d k="D냉대" v="최한월 –3↓"/>
      <d k="E한대" v="최난월 10↓"/>
      <note>서안해양성은 최난월 기온 22도↓</note>
      <note>열대의 건기 기준은 60+- / 온대 기준은 30 +</note>
      <q>
        <ask>온대(C)로 판정되는 기후 자료를 모두 고르시오. (최한월 · 최난월 · 연 강수량)</ask>
        <opt ok="1">5℃ · 25℃ · 1,200mm</opt>
        <opt ok="1">−2℃ · 22℃ · 1,000mm</opt>
        <opt ok="1">17℃ · 24℃ · 900mm</opt>
        <opt>19℃ · 27℃ · 2,000mm</opt>
        <opt>−5℃ · 20℃ · 600mm</opt>
        <opt>10℃ · 26℃ · 300mm</opt>
        <why>최한월 −3℃ 이상 18℃ 미만이면 온대. 19℃는 열대, −5℃는 냉대, 강수 300mm는 건조.</why>
      </q>
      <q>
        <ask>한대(E)로 판정되는 기후 자료를 모두 고르시오. (최한월 · 최난월)</ask>
        <opt ok="1">−20℃ · 8℃</opt>
        <opt ok="1">−40℃ · −10℃</opt>
        <opt ok="1">−25℃ · 9.5℃</opt>
        <opt>−30℃ · 12℃</opt>
        <opt>−3.5℃ · 15℃</opt>
        <opt>−15℃ · 10.5℃</opt>
        <why>최난월이 10℃ 미만이면 겨울이 얼마나 춥든 한대. 최난월 10℃ 이상이고 최한월 −3℃ 미만이면 냉대.</why>
      </q>
      <q>
        <ask>연중 비가 고른 지역에서, 서안 해양성(Cfb)으로 판정되는 자료를 모두 고르시오. (최한월 · 최난월)</ask>
        <opt ok="1">4℃ · 17℃</opt>
        <opt ok="1">6℃ · 21.5℃</opt>
        <opt ok="1">−1℃ · 18℃</opt>
        <opt>3℃ · 23℃</opt>
        <opt>−4℃ · 18℃</opt>
        <opt>9℃ · 26℃</opt>
        <why>온대(최한월 −3℃ 이상)이면서 최난월 22℃ 미만이면 b. 22℃ 이상이면 온난 습윤(Cfa), −4℃는 냉대.</why>
      </q>
    </section>
    <section n="22" title="쾨펜의 기후구분별 구체적 위치">
      <figure src="img/codex/image15.webp" caption="쾨펜·가이거 기후 구분 (1991–2020)"/>
      <d k="Af" v="적도일대"/>
      <note>의외로 아프리카는 Af가 거의 없다 – 키상가니(DRC)이외에는 거의 출제되지 않는 듯 하다</note>
      <d k="Am" v="아마존, 마이애미, 뭄바이, 인도차이나, 필리핀"/>
      <d k="Aw" v="적도 – 회귀선 사이 분포"/>
      <note>마사이마라(케냐) =&gt; 적도이지만 Aw</note>
      <group title="BW · 사막">
        <figure src="img/codex/image16.webp" caption="세계의 사막 분류 — 아열대 고압대·한류·내륙·비그늘"/>
        <note>일부 난류지역에 한류사막이 존재한다면 그것은 용승으로 인한 것</note>
        <group title="연중아열대 고압대 사막" i="1">
          <li>사하라 사막 / 아라비아사막</li>
          <li>소노란 사막 (미국 남서부, 멕시코 북서부 – 캘리포니아반도)</li>
          <li>치와와 사막 (미국 남서부, 멕시코) / 칼라하리 사막 – (아프리카 남동부)</li>
          <li>그레이트빅토리아 &amp; 그레이트 샌디 사막 (호주) / 타르 사막 (인도-파키스탄)</li>
        </group>
        <group title="한류사막" i="2">
          <li>아타카마 사막 (칠레) - 페루헤류 / 나미브 사막 (나미비아) - 벵겔라해류</li>
          <li>바히칼리포르니아 사막(멕시코) – 캘리포니아 한류</li>
        </group>
        <group title="내륙사막" i="3">
          <li>고비사막 (몽골- 중국) /타클라마칸 사막 (중국 신장지구)</li>
          <li>투르케스탄/카라쿰 사막 (투르크메니스탄)</li>
          <li>키질쿰 사막 (우즈벡 – 카자흐)</li>
        </group>
        <group title="비그늘사막" i="4">
          <li>파타고니아 산맥(아르헨티나) – 안데스산맥</li>
          <li>모하비사막(미국) - 시에라네바다산맥</li>
          <li>그레이트베이슨 사막 – 시에라네바다 &amp; 케스케이드 산맥</li>
          <note>베네수엘라 마라카이보호수 남동부는 일대는 번개가 가장 많이 치는 호수이지만 북서부는 아열대고압대 사막</note>
          <note>마라카이보호수의 카타툼보 번개는 출제확률이 낮으나 알아두면 좋을듯</note>
        </group>
      </group>
      <group title="BS · 스텝">
        <li>사헬(사하라 남쪽)</li>
        <li>중앙아시아 &amp; 몽골의 초원</li>
      </group>
      <group title="ET · 툰드라">
        <li>푼타아레나스, 우수아이아 + 북극해연안</li>
      </group>
      <group title="EF · 빙설">
        <li>그린란드 내륙 + 남극대륙</li>
      </group>
      <q>
        <ask>사바나 기후가 나타나는 곳을 모두 고르시오.</ask>
        <opt ok="1">케냐 마사이마라</opt>
        <opt ok="1">탄자니아 세렝게티</opt>
        <opt ok="1">베네수엘라 야노스</opt>
        <opt>콩고민주공화국 키상가니</opt>
        <opt>싱가포르</opt>
        <opt>브라질 마나우스</opt>
        <why>동아프리카는 적도 가까이지만 고원이라 건기가 뚜렷하다. 키상가니·싱가포르·마나우스는 열대 우림(Af).</why>
      </q>
      <q>
        <ask>한류의 영향으로 생긴 사막을 모두 고르시오.</ask>
        <opt ok="1">아타카마 사막</opt>
        <opt ok="1">나미브 사막</opt>
        <opt ok="1">바하칼리포르니아 사막</opt>
        <opt>파타고니아 사막</opt>
        <opt>고비 사막</opt>
        <opt>모하비 사막</opt>
        <why>페루 해류·벵겔라 해류·캘리포니아 해류. 파타고니아·모하비는 비그늘, 고비는 내륙 사막.</why>
      </q>
      <q>
        <ask>비그늘 사막을 모두 고르시오.</ask>
        <opt ok="1">파타고니아 사막</opt>
        <opt ok="1">모하비 사막</opt>
        <opt ok="1">그레이트베이슨 사막</opt>
        <opt>소노란 사막</opt>
        <opt>타클라마칸 사막</opt>
        <opt>아타카마 사막</opt>
        <why>파타고니아는 안데스, 모하비·그레이트베이슨은 시에라네바다(·캐스케이드)의 비그늘. 소노란은 아열대 고압대, 타클라마칸은 내륙, 아타카마는 한류.</why>
      </q>
      <q>
        <ask>연중 아열대 고압대의 영향으로 생긴 사막을 모두 고르시오.</ask>
        <opt ok="1">칼라하리 사막</opt>
        <opt ok="1">타르 사막</opt>
        <opt ok="1">치와와 사막</opt>
        <opt ok="1">그레이트빅토리아 사막</opt>
        <opt>고비 사막</opt>
        <opt>나미브 사막</opt>
        <opt>모하비 사막</opt>
        <opt>카라쿰 사막</opt>
        <why>회귀선 부근의 사막들. 고비·카라쿰은 내륙, 나미브는 한류, 모하비는 비그늘.</why>
      </q>
    </section>
    <section n="23" title="열대기후">
      <li>이동식 화전(자급적, 광범위) / 플랜테이션(기업적, 국지적)</li>
      <d k="토양" v="라테라이트(산화철 -&gt; 적색) =&gt; 벽돌로 주로 사용됨"/>
      <group title="Af · 열대우림">
        <d k="이동식화전" v="옥수수, 카사바 재배"/>
        <d k="플랜테이션" v="기호작물, 공업원료"/>
        <d k="식생" v="상록활엽수, 밀림, 생물 다양성 가장큼"/>
        <d k="가옥" v="고상가옥 or 수상가옥 (지붕경사↑-강수량 多때문)"/>
        <note>스콜을 피하기 위해 한쪽벽이 없는 회랑구조도 많이 이용된다</note>
        <note>고상가옥은 해충과 지열, 호우로부터 집을 지켜준다</note>
      </group>
      <group title="Aw · 사바나">
        <d k="플랜테이션" v="목화, 커피, 사탕수수"/>
        <d k="식생" v="소림(ex 아카시아), 장초"/>
      </group>
      <group title="Am · 열대몬순">
        <d k="플랜테이션" v="차(스리랑카 인도네시아 등)"/>
        <li>쌀의 2~3기작</li>
        <d k="식생" v="밀림(정글)"/>
        <d k="가옥" v="고상가옥 or 수상가옥"/>
        <note>캄보디아의 앙코르와트는 라테라이트로 만든 벽돌을 이용해 만들었음</note>
        <note>케냐와 탄자니아의 마사이족은 유목을 함</note>
        <note>AH는 감자와 맥류 등 냉량성 작물을 재배함. 야크(TIBET) / 라마&amp;알파카(ANDES)</note>
      </group>
      <q>
        <ask>라테라이트에 대한 설명으로 옳은 것을 모두 고르시오.</ask>
        <opt ok="1">철·알루미늄 산화물 때문에 붉다</opt>
        <opt ok="1">양분이 씻겨 나가 척박하다</opt>
        <opt ok="1">굳혀서 벽돌로 쓴다</opt>
        <opt ok="1">앙코르와트를 쌓는 데 쓰였다</opt>
        <opt>유기물이 많아 가장 비옥하다</opt>
        <opt>석회암이 풍화되어 생긴다</opt>
        <opt>회백색의 강한 산성 토양이다</opt>
        <why>유기물이 많은 것은 흑토, 석회암 풍화는 테라로사, 회백색 강산성은 포드졸.</why>
      </q>
      <q>
        <ask>플랜테이션 작물과 기후의 짝으로 옳은 것을 모두 고르시오.</ask>
        <opt ok="1">차 — 열대 몬순(Am)</opt>
        <opt ok="1">목화 — 사바나(Aw)</opt>
        <opt ok="1">사탕수수 — 사바나(Aw)</opt>
        <opt>올리브 — 열대 우림(Af)</opt>
        <opt>대추야자 — 열대 몬순(Am)</opt>
        <opt>커피 — 서안 해양성(Cfb)</opt>
        <why>올리브는 지중해성, 대추야자는 사막의 오아시스 작물, 커피는 열대 고원·사바나 작물이다.</why>
      </q>
      <q>
        <ask>지역과 가축의 짝으로 옳은 것을 모두 고르시오.</ask>
        <opt ok="1">안데스 고산 — 라마·알파카</opt>
        <opt ok="1">티베트고원 — 야크</opt>
        <opt ok="1">시베리아 툰드라 — 순록</opt>
        <opt>티베트고원 — 알파카</opt>
        <opt>안데스 고산 — 야크</opt>
        <opt>몽골 고원 — 라마</opt>
        <why>라마·알파카는 안데스에만, 야크는 티베트·히말라야(와 몽골 일부)에 산다. 툰드라는 순록.</why>
      </q>
    </section>
    <section n="24" title="온대기후">
      <d k="식생" v="혼합림(활엽수 + 침엽수)- 토양 : 갈색토"/>
      <group title="Cs · 지중해성">
        <d k="여름" v="수목樹木농업"/>
        <d k="겨울" v="냉량성작물 + 채소"/>
        <d k="식생" v="경엽수림 (올리브, 오렌즈 등) -&gt; 여름건기에 버틸수있도록"/>
        <d k="가옥" v="건물의 외벽 흰색 -&gt; 햇빛 반사 / 작은창, 두꺼운 벽, 좁은 골목"/>
        <note>(모로코 – 카사블랑카 / 그리스 – 산토리니섬 등이 대표적)</note>
        <note>사막의 가옥과 상당히 유사하다. 여름철 기후가 사막기후와 비슷하게 일조시간이 길고 뜨거우므로 단열에 적합하도록 지어졌다</note>
      </group>
      <group title="Cfb · 서안해양성">
        <li>혼합농업(식량+가축+사료) / 낙농업+원예농업(북해연안)</li>
        <li>냉량성작물 재배</li>
      </group>
      <group title="Cfa · Cw — 동안형 기후">
        <d k="동아시아" v="벼농사"/>
        <d k="북미 남동부" v="옥수수(오대호 남쪽) / 목화(미국 남동부)"/>
        <d k="남미 남동부" v="팜파스 -&gt; 밀농사 + 목축업"/>
      </group>
      <q>
        <ask>지중해성 기후가 나타나는 곳을 모두 고르시오.</ask>
        <opt ok="1">미국 캘리포니아 해안</opt>
        <opt ok="1">칠레 중부</opt>
        <opt ok="1">남아공 케이프타운</opt>
        <opt ok="1">오스트레일리아 퍼스</opt>
        <opt>미국 플로리다</opt>
        <opt>칠레 남부</opt>
        <opt>브라질 남부</opt>
        <why>위도 30~40° 대륙 서안. 칠레 남부는 서안 해양성, 플로리다·브라질 남부는 동안의 온난 습윤.</why>
      </q>
      <q>
        <ask>서안 해양성 기후가 나타나는 곳을 모두 고르시오.</ask>
        <opt ok="1">런던</opt>
        <opt ok="1">파리</opt>
        <opt ok="1">뉴질랜드 웰링턴</opt>
        <opt ok="1">칠레 푸에르토몬트</opt>
        <opt>로마</opt>
        <opt>도쿄</opt>
        <opt>뉴욕</opt>
        <opt>부에노스아이레스</opt>
        <why>로마는 지중해성, 도쿄·뉴욕·부에노스아이레스는 여름이 더운 온난 습윤(Cfa).</why>
      </q>
      <q>
        <ask>지중해성 기후에 대한 설명으로 옳은 것을 모두 고르시오.</ask>
        <opt ok="1">여름은 덥고 건조하다</opt>
        <opt ok="1">겨울은 온화하고 비가 온다</opt>
        <opt ok="1">올리브·포도 같은 수목 농업이 발달했다</opt>
        <opt ok="1">잎이 작고 두꺼운 경엽수가 자란다</opt>
        <opt>여름에 벼농사가 활발하다</opt>
        <opt>겨울이 건기다</opt>
        <opt>침엽수림이 넓게 펼쳐진다</opt>
        <why>여름 건기를 견디는 나무를 기르고, 비가 오는 겨울에 밀과 채소를 기른다.</why>
      </q>
      <q>
        <ask>지역과 농업의 짝으로 옳은 것을 모두 고르시오.</ask>
        <opt ok="1">동아시아 — 벼농사</opt>
        <opt ok="1">미국 남동부 — 목화</opt>
        <opt ok="1">아르헨티나 팜파스 — 밀·소 목축</opt>
        <opt ok="1">북해 연안 — 낙농업·원예 농업</opt>
        <opt>아르헨티나 팜파스 — 벼농사</opt>
        <opt>오대호 남쪽 — 벼농사</opt>
        <opt>북해 연안 — 수목 농업</opt>
        <why>오대호 남쪽은 옥수수 지대(콘벨트), 수목 농업은 지중해성 기후.</why>
      </q>
    </section>
    <section n="25" title="냉대기후(Dw, Df)">
      <li>냉량성작물 재배</li>
      <d k="식생" v="침엽수림(타이가) -&gt; 단일수종 집적 =&gt; 세계적 임업지역"/>
      <d k="토양" v="회백색의 강산성 (포드졸)"/>
      <q>
        <ask>냉대 기후에 대한 설명으로 옳은 것을 모두 고르시오.</ask>
        <opt ok="1">타이가가 넓게 펼쳐진다</opt>
        <opt ok="1">포드졸이 나타난다</opt>
        <opt ok="1">한두 수종이 무리 지어 임업이 발달했다</opt>
        <opt ok="1">Dw 는 겨울이 건조하다</opt>
        <opt>생물 다양성이 가장 크다</opt>
        <opt>Dw 는 유럽에 넓게 나타난다</opt>
        <opt>라테라이트가 나타난다</opt>
        <why>w 는 겨울 건조. 시베리아 고기압 때문에 Dw 는 동아시아 북부에만 나타난다.</why>
      </q>
    </section>
    <section n="26" title="건조기후">
      <group title="BW · 사막">
        <d k="관개농업" v="오아시스, 외래하천, 지하관개수로(카나트), 안개집수, 해수담수화"/>
        <note>외래하천이란 건조기후가 아닌곳에서 발원하여 사막을 통과하는 하천</note>
        <d k="작물" v="대추야자, 밀(내건성 내한성↑)"/>
        <d k="가축" v="염소, 양, 낙타"/>
        <d k="토양" v="사막토(염류토)"/>
        <d k="가옥" v="두꺼운 흙벽, 평평한 지붕, 좁은 골목 -&gt; 그늘형성, 작은창문"/>
        <note>강수량이 적고 건조하므로 단열성능을 높이고 햇빛을 피하기위한 구조가 나타난다</note>
        <note>식생은 선인장 등을 제외하면 거의 없다고 보면 된다</note>
      </group>
      <group title="BS · 스텝">
        <li>목축(구대륙은 유목, 신대륙은 방목, 알프스는 이목)</li>
        <li>밀농사</li>
        <li>호주의 대찬정분지</li>
        <d k="가옥" v="유목이 용이하도록 이동식 가옥"/>
        <d k="식생" v="단초초원"/>
        <d k="토양" v="흑토(초원의 유기물이 풍부해 가장 비옥함)"/>
        <li>흑토의 분포– 체르노젬(우크라이나 일대) / 프레리토 (로키-오대호 사이) -&gt; 밀</li>
        <note>명칭 – 중국 파오, 몽골 게르, 중앙아시아 유르트</note>
        <note>수특에도 있는 내용이지만 툰드라와 알프스의 이목은 상당히 비슷한데 여름같은경우는 고지대도 풀이 있고 저지대도 풀이있으니까 저지대 풀을 아끼고 겨울에는 저지대에만 있으니까 저지대 풀을 먹이는 식으로 작동한다.</note>
      </group>
      <q>
        <ask>건조하지 않은 곳에서 발원해 사막을 지나는 외래 하천을 모두 고르시오.</ask>
        <opt ok="1">나일강</opt>
        <opt ok="1">인더스강</opt>
        <opt ok="1">티그리스강</opt>
        <opt>콩고강</opt>
        <opt>아마존강</opt>
        <opt>라인강</opt>
        <opt>메콩강</opt>
        <why>나일은 적도 부근 고원, 인더스는 히말라야, 티그리스는 튀르키예 산지에서 발원한다.</why>
      </q>
      <q>
        <ask>흑토에 해당하는 것을 모두 고르시오.</ask>
        <opt ok="1">체르노젬</opt>
        <opt ok="1">프레리토</opt>
        <opt ok="1">팜파스토</opt>
        <opt>포드졸</opt>
        <opt>라테라이트</opt>
        <opt>테라로사</opt>
        <why>초원 풀뿌리의 유기물이 쌓인 가장 비옥한 토양. 체르노젬은 우크라이나, 프레리토는 로키–오대호 사이, 팜파스토는 아르헨티나.</why>
      </q>
      <q>
        <ask>이동식 가옥과 지역의 짝으로 옳은 것을 모두 고르시오.</ask>
        <opt ok="1">게르 — 몽골</opt>
        <opt ok="1">유르트 — 중앙아시아</opt>
        <opt ok="1">파오 — 중국</opt>
        <opt>춈 — 몽골</opt>
        <opt>이글루 — 중앙아시아</opt>
        <opt>유르트 — 시베리아 툰드라</opt>
        <why>춈은 시베리아 툰드라의 순록 유목민 천막, 이글루는 이누이트의 사냥용 임시 가옥.</why>
      </q>
      <q>
        <ask>목축 방식과 지역의 짝으로 옳은 것을 모두 고르시오.</ask>
        <opt ok="1">구대륙 스텝 — 유목</opt>
        <opt ok="1">미국·오스트레일리아 — 기업적 방목</opt>
        <opt ok="1">알프스 — 이목</opt>
        <opt>알프스 — 유목</opt>
        <opt>몽골 초원 — 기업적 방목</opt>
        <opt>오스트레일리아 대찬정 분지 — 이목</opt>
        <why>이목은 계절마다 산 위(여름)와 골짜기(겨울)를 오가는 알프스식. 대찬정 분지는 지하수로 양을 치는 기업적 방목.</why>
      </q>
    </section>
    <section n="27" title="한대 기후">
      <group title="ET · 툰드라">
        <li>여름에 고위도 / 겨울에 저위도로 이동 -&gt; 순록 유목</li>
        <d k="지구온난화" v="농경 &amp; 목축 일부 가능"/>
        <d k="가옥" v="춈(텐트형주거시설) -&gt; 순록유목을 위함 / 이글루 : 사냥용 임시가옥"/>
        <li>고상가옥 – 난방열로인해 활동층이 융해되는 것을 방지한다</li>
        <note>고상가옥은 그래서 기둥을 영구동토층에 심는데, 영구동토층이 지구온난화로 융해되면서 사고가 발생하는 중</note>
        <note>춈은 러시아 북서시베리아 지역에서, 이글루는 이누이트족(알래스카, 캐나다, 그린란드)</note>
      </group>
      <group title="EF · 빙설">
        <li>농업X</li>
        <li>식생X</li>
        <d k="남극" v="세종기지, 장보고기지 / 평균해발고도가 가장 높은 대륙"/>
        <d k="북극" v="다산기지(스발바르제도 NOR)"/>
        <d k="북극항로" v="지구온난화로 이용가능기간이 늘어나며 주목"/>
        <note>남극의 평균 해발고도는2300m이며 두꺼운 대륙빙하로 인해 해발고도가 높은 것이다.</note>
        <note>북극은 자원 등으로 인해 분쟁이 많으나 남극은 협약으로 인해 분쟁이 없다</note>
        <note>전 기후 중 유일하게 빙설기후는 사람이 살지않는다</note>
      </group>
      <compare title="기후별 토양 · 식생 · 가옥" cols="토양 | 식생 | 가옥">
        <row k="열대" v="라테라이트(산화철 -&gt; 적색) =&gt; 벽돌로 주로 사용됨 | 상록활엽수, 밀림, 생물 다양성 가장큼  〔Af · 열대우림〕 | 고상가옥 or 수상가옥 (지붕경사↑-강수량 多때문)  〔Af · 열대우림〕"/>
        <row k="온대" v="갈색토 | 혼합림(활엽수 + 침엽수) | 건물의 외벽 흰색 -&gt; 햇빛 반사 / 작은창, 두꺼운 벽, 좁은 골목  〔Cs · 지중해성〕"/>
        <row k="냉대" v="회백색의 강산성 (포드졸) | 침엽수림(타이가) -&gt; 단일수종 집적 =&gt; 세계적 임업지역 | "/>
        <row k="건조" v="사막토(염류토)  〔BW · 사막〕 | 단초초원  〔BS · 스텝〕 | 두꺼운 흙벽, 평평한 지붕, 좁은 골목 -&gt; 그늘형성, 작은창문  〔BW · 사막〕"/>
        <row k="한대" v=" |  | 춈(텐트형주거시설) -&gt; 순록유목을 위함 / 이글루 : 사냥용 임시가옥  〔ET · 툰드라〕"/>
      </compare>
      <q>
        <ask>툰드라 기후에 대한 설명으로 옳은 것을 모두 고르시오.</ask>
        <opt ok="1">순록은 여름에 고위도로, 겨울에 저위도로 옮긴다</opt>
        <opt ok="1">고상 가옥은 난방열이 활동층을 녹이지 않게 한다</opt>
        <opt ok="1">이글루는 이누이트의 사냥용 임시 가옥이다</opt>
        <opt>춈은 알래스카 이누이트의 집이다</opt>
        <opt>영구 동토층이 여름마다 모두 녹는다</opt>
        <opt>사람이 살지 않는다</opt>
        <why>여름에 녹는 것은 위쪽 활동층뿐이다. 춈은 시베리아. 사람이 살지 않는 기후는 빙설(EF).</why>
      </q>
      <q>
        <ask>극지방에 대한 설명으로 옳은 것을 모두 고르시오.</ask>
        <opt ok="1">남극에는 세종 기지와 장보고 기지가 있다</opt>
        <opt ok="1">북극 다산 기지는 스발바르 제도에 있다</opt>
        <opt ok="1">남극은 평균 해발 고도가 가장 높은 대륙이다</opt>
        <opt ok="1">남극 조약으로 영유권 주장이 묶여 있다</opt>
        <opt>북극은 두꺼운 빙하로 덮인 대륙이다</opt>
        <opt>남극 조약으로 각국의 영유권이 인정되었다</opt>
        <opt>빙설 기후에도 순록 유목민이 산다</opt>
        <why>북극은 바다가 언 것이다. 남극 조약은 영유권 주장을 인정하지도 부정하지도 않고 동결했다. 남극의 높은 고도는 두께 수 km 의 대륙 빙하 때문.</why>
      </q>
      <q>
        <ask>툰드라 기후가 나타나는 곳을 모두 고르시오.</ask>
        <opt ok="1">그린란드 해안</opt>
        <opt ok="1">시베리아 북극해 연안</opt>
        <opt ok="1">캐나다 북부</opt>
        <opt>그린란드 내륙</opt>
        <opt>남극 대륙 내륙</opt>
        <opt>핀란드 남부</opt>
        <why>그린란드 내륙과 남극은 빙설(EF), 핀란드 남부는 냉대.</why>
      </q>
    </section>
  </part>
  <part id="land" title="지형" desc="대지형과 판 구조, 화산, 그리고 외적영력이 깎아 낸 소지형">
    <section n="28" title="대지형">
      <d k="내적영력" v="맨틀의 대류"/>
      <li>조륙(융기, 침강), 조산(습곡, 단층), 화산 활동 등을 일으킴</li>
      <group title="안정육괴">
        <li>시생누대, 원생누대에 조산운동을 받음 -&gt; 오랜침식으로 평탄</li>
        <d k="분포" v="대륙 내부(시베리아, 발트, 로렌시아, 아프리카 브라질, 호주, 인도)"/>
        <d k="자원" v="철광석 풍부"/>
      </group>
      <group title="고기습곡산지">
        <li>고생대 조산운동을 받음 -&gt; 오랜침식으로 완만 (과거 판의 경계)</li>
        <d k="분포" v="그레이트디바이딩, 애팔래치아, 드라켄즈버그, 스칸디나비아, 우랄 등"/>
        <d k="자원" v="석탄 등이 풍부"/>
      </group>
      <group title="신기습곡산지">
        <li>중생대 말 ~ 신생대에 조산운동을 받음 -&gt; 현재 판의 경계</li>
        <li c="1">지진과 화산이 활발하고 높고 험준한 산지</li>
        <d k="환태평양 조산대" v="태평양 연안 대부분에 위치"/>
        <li>알프스 히말라야 조산대</li>
        <li c="1">(유라시아판)과 (아프리카판, 아라비아판, 인도호주판)이 만나는 지점 모두</li>
        <d k="자원" v="석유 천연가스, 구리, 주석 (석유와 천연가스의 60%가량 매장됨)"/>
        <note>110611 -수마트라섬과 자바섬은 알프스 히말라야 조산대임을 알아야하는 기출이 있다</note>
        <note>발산형경계는 조산대가 아니다.(신기습곡X)</note>
        <figure src="img/codex/image17.webp" caption="관련 기출 — 수마트라섬과 자바섬"/>
      </group>
      <q>
        <ask>안정육괴에 해당하는 곳을 모두 고르시오.</ask>
        <opt ok="1">캐나다 허드슨만 주변</opt>
        <opt ok="1">시베리아</opt>
        <opt ok="1">브라질 고원</opt>
        <opt ok="1">오스트레일리아 서부</opt>
        <opt>애팔래치아 산맥</opt>
        <opt>우랄 산맥</opt>
        <opt>안데스 산맥</opt>
        <why>시생·원생누대의 오래된 땅, 철광석이 많다. 애팔래치아·우랄은 고기 습곡, 안데스는 신기 습곡.</why>
      </q>
      <q>
        <ask>고기 습곡 산지를 모두 고르시오.</ask>
        <opt ok="1">우랄 산맥</opt>
        <opt ok="1">드라켄즈버그 산맥</opt>
        <opt ok="1">스칸디나비아 산맥</opt>
        <opt ok="1">그레이트디바이딩 산맥</opt>
        <opt>로키 산맥</opt>
        <opt>아틀라스 산맥</opt>
        <opt>알프스 산맥</opt>
        <why>고생대 조산 운동 뒤 오래 깎여 완만하고 석탄이 많다. 로키·아틀라스·알프스는 신기 습곡.</why>
      </q>
      <q>
        <ask>알프스–히말라야 조산대에 속하는 것을 모두 고르시오.</ask>
        <opt ok="1">자그로스 산맥</opt>
        <opt ok="1">아틀라스 산맥</opt>
        <opt ok="1">수마트라섬</opt>
        <opt>안데스 산맥</opt>
        <opt>일본 열도</opt>
        <opt>우랄 산맥</opt>
        <why>유라시아판과 아프리카·아라비아·인도–오스트레일리아판이 만나는 곳 모두. 수마트라·자바가 여기 든다는 기출이 있다.</why>
      </q>
      <q>
        <ask>환태평양 조산대에 속하는 것을 모두 고르시오.</ask>
        <opt ok="1">안데스 산맥</opt>
        <opt ok="1">로키 산맥</opt>
        <opt ok="1">일본 열도</opt>
        <opt ok="1">뉴질랜드</opt>
        <opt>히말라야 산맥</opt>
        <opt>알프스 산맥</opt>
        <opt>자그로스 산맥</opt>
        <why>태평양 가장자리. 히말라야·알프스·자그로스는 알프스–히말라야 조산대.</why>
      </q>
    </section>
    <section n="29" title="판 구조">
      <figure src="img/codex/image18.webp" caption="세계의 판 구조"/>
      <group title="대륙판">
        <li>아라비아판</li>
      </group>
      <group title="해양판">
        <li>코코스판, 필리핀판, 나스카판, 태평양판</li>
        <note>지도상 육지는 대륙판, 바다는 해양판으로 간주하면 됨 (기타생략)</note>
      </group>
      <group title="보존형 경계">
        <li>후안데푸카판 남쪽 태평양판 + 북미판 -&gt; 산안드레아스 단층</li>
        <li>뉴질랜드 알파인 단층대 -&gt; 남섬에 위치(화산X, 빙하 多)</li>
      </group>
      <q>
        <ask>해양판을 모두 고르시오.</ask>
        <opt ok="1">나스카판</opt>
        <opt ok="1">코코스판</opt>
        <opt ok="1">필리핀판</opt>
        <opt ok="1">후안데푸카판</opt>
        <opt>아라비아판</opt>
        <opt>유라시아판</opt>
        <opt>북아메리카판</opt>
        <why>후안데푸카판은 미국 북서부 앞바다의 작은 해양판. 아라비아판은 아라비아반도를 실은 대륙판이다.</why>
      </q>
      <q>
        <ask>판 경계의 종류가 옳게 짝지어진 것을 모두 고르시오.</ask>
        <opt ok="1">산안드레아스 단층 — 보존형</opt>
        <opt ok="1">뉴질랜드 알파인 단층 — 보존형</opt>
        <opt ok="1">대서양 중앙 해령 — 발산형</opt>
        <opt ok="1">동아프리카 지구대 — 발산형</opt>
        <opt>아이슬란드 — 보존형</opt>
        <opt>히말라야 산맥 — 발산형</opt>
        <opt>안데스 산맥 — 보존형</opt>
        <why>아이슬란드는 대서양 중앙 해령 위(발산형), 히말라야·안데스는 수렴형.</why>
      </q>
    </section>
    <section n="30" title="화산">
      <group title="현무암질">
        <d k="순상화산" v="하와이(열점)"/>
        <d k="용암대지" v="열하분출 (미국 북서부 컬럼비아고원, 데칸고원 북서부)"/>
        <d k="용암동굴" v="높은 유동성의 현무암질이 흘러내리며 형성"/>
      </group>
      <group title="유문·조면·안산암질">
        <d k="성층화산" v="용암과 화산쇄설물이 교대로 분출 (세계 유명화산 대부분)"/>
        <note>킬리만자로, 후지, 마욘산 등이 해당함</note>
        <d k="용암돔(종상화산)" v="가장 용암의 점성이 강함, 화구 함몰 -&gt; 칼데라(분지)"/>
        <note>화구호는 함몰되지않은채로 물이 고인 것이고, 칼데라호는 함몰이후에 물이고인 것(백록담은 화구호, 천지는 칼데라호)</note>
        <note>중앙화구구는 함몰 이후에 형성된다</note>
        <note>대표적 위치는 크레이터호, 로토루아호, 토바호, 아이라칼데라, 옐로스톤국립공원 등이 있다.</note>
      </group>
      <group title="기타 화산지형">
        <li>주상절리 – 용암의 냉각수축 -&gt; 기둥모양으로 형성됨</li>
        <d k="간헐천" v="온천수 + 수증기 -&gt; 주기적으로 솟구치는 온천"/>
      </group>
      <group title="화산지대의 장점">
        <d k="무기질 多 토양" v="농업에 유리함(일본의 간토평야)"/>
        <d k="관광자원" v="온천 -&gt; 일본(벳푸), 아이슬란드(블루라곤) / 간헐천 -&gt; 옐로스톤"/>
        <li>지열발전 가능</li>
        <d k="지하자원 多" v="각종 금속광물 (칠레 구리1위, 멕시코 은 1위)"/>
      </group>
      <q>
        <ask>성층 화산을 모두 고르시오.</ask>
        <opt ok="1">후지산</opt>
        <opt ok="1">킬리만자로산</opt>
        <opt ok="1">마욘산</opt>
        <opt ok="1">에트나산</opt>
        <opt>마우나로아산</opt>
        <opt>킬라우에아산</opt>
        <opt>한라산</opt>
        <why>용암과 화산재가 번갈아 쌓인 원뿔. 마우나로아·킬라우에아(하와이)와 한라산은 완만한 순상 화산이다(한라산 꼭대기만 종상).</why>
      </q>
      <q>
        <ask>칼데라(호)를 모두 고르시오.</ask>
        <opt ok="1">미국 크레이터호</opt>
        <opt ok="1">인도네시아 토바호</opt>
        <opt ok="1">백두산 천지</opt>
        <opt ok="1">옐로스톤</opt>
        <opt>한라산 백록담</opt>
        <opt>오대호</opt>
        <opt>바이칼호</opt>
        <why>분화 뒤 화구가 무너져 생긴 분지. 백록담은 무너지지 않은 화구호, 오대호는 빙하호, 바이칼호는 열곡에 생긴 호수.</why>
      </q>
      <q>
        <ask>현무암질 용암과 그 지형에 대한 설명으로 옳은 것을 모두 고르시오.</ask>
        <opt ok="1">유동성이 커서 멀리 흘러간다</opt>
        <opt ok="1">순상 화산을 만든다</opt>
        <opt ok="1">열하 분출로 용암 대지를 만든다</opt>
        <opt ok="1">용암 동굴이 생긴다</opt>
        <opt>점성이 가장 커서 종 모양 화산을 만든다</opt>
        <opt>용암과 화산재가 번갈아 쌓인다</opt>
        <opt>분화 뒤 함몰해 칼데라를 잘 만든다</opt>
        <why>종상 화산·칼데라는 점성이 큰 유문암질, 성층 화산은 안산암질 쪽.</why>
      </q>
      <q>
        <ask>화산 지대를 이용한 사례를 모두 고르시오.</ask>
        <opt ok="1">일본 벳푸 온천</opt>
        <opt ok="1">아이슬란드 블루라군</opt>
        <opt ok="1">옐로스톤 간헐천 관광</opt>
        <opt ok="1">아이슬란드 지열 발전</opt>
        <opt>중국 구이린 관광</opt>
        <opt>노르웨이 피오르 관광</opt>
        <opt>미국 모뉴먼트 밸리 관광</opt>
        <why>구이린은 카르스트, 피오르는 빙하, 모뉴먼트 밸리는 건조 지형.</why>
      </q>
    </section>
    <section n="31" title="소지형(외적영력)">
      <group title="외적영력">
        <li>태양, 바람, 파도, 강물 등 -&gt; 풍화와 침식, 운반, 퇴적, 등</li>
        <d k="풍화" v="때리지 않아도 깨지거나(기계적) 녹는 것(화학적)"/>
        <d k="침식" v="물리적 타격으로 깨짐"/>
      </group>
      <group title="카르스트 지형">
        <li>석회함의 용식으로 형성된 지형들(탄산수에 더 쉽게 용식됨)</li>
        <li>배수가 양호해 밭농사 / 대부분 건천</li>
        <li>고온다습할수록 용식작용 활발</li>
        <group title="와지(웅덩이)" i="1">
          <li>돌리네 여러개 우발라 더 크면 폴리예(평탄한 분지)</li>
        </group>
        <group title="카렌" i="2">
          <li>차별 용식 + 부분침식</li>
          <li>뾰족한 기둥군락</li>
          <li>마다가스카르 그랑칭기, 중국 원난성 석림</li>
        </group>
        <group title="탑 카르스트" i="3">
          <li>차별 용식 + 부분침식</li>
          <li>봉우리</li>
          <li>중국 남부 구이린, 베트남 하롱베이, 필리핀 초콜릿 힐스</li>
        </group>
        <group title="석회화 단구" i="4">
          <d k="경사지" v="침전"/>
          <li>터키 파묵칼레, 중국 쓰촨성 황룽</li>
        </group>
        <group title="석회동굴" i="5">
          <li>바닥에서 석순, 천장에서 종유석 자라나고, 합쳐지면 석주</li>
        </group>
        <group title="테라로사 – 비가용성 물질이 잔류하여 붉게보이는 토양" i="6">
          <li>(라테라이트처럼 농사에 어려움이있음)</li>
        </group>
      </group>
      <group title="건조 지형">
        <group title="바람이 만든 것">
          <d k="사구" v="바람받이 완사면 (여러개 바르한) - 퇴적"/>
          <d k="버섯바위" v="차별침식"/>
          <d k="삼릉석" v="차별침식"/>
          <d k="사막포도" v="침식(무거운 돌만 남고 가벼운것들은 날아가서 형성됨)"/>
        </group>
        <group title="물이 만든 것">
          <d k="와디" v="건천(교통로) (포상홍수침식 -&gt; 비가 오면 흐름)"/>
          <d k="플라야" v="염호 -&gt; NaCl, Li 등 채취"/>
          <d k="선상지" v="경사가 급변하는 곡구에서 형성되는 퇴적완사면 (여러개 바하다)"/>
          <note>분급이 양호하지는 않으나 대체로 아래로 내려갈수록 입자 크기 작아짐</note>
          <d k="메사 &amp; 뷰트" v="상단이 경암층, 미국 남서부 내륙, 유수에 의한 차별침식"/>
        </group>
      </group>
      <group title="빙하 지형">
        <li>과거 빙하 지역 (영국이북, 오대호이북, 뉴질랜드 남섬, 칠레 남부)</li>
        <note>과거 배링해, 북해, 황해, 남해, 호주-뉴기니섬 사이 등이 육지였음</note>
        <group title="침식 지형">
          <li>산정빙하 (혼 : 봉우리 / 권곡 : 삼면이 절벽인 반구형 와지)</li>
          <d k="U자곡" v="V자곡(하식곡)이 빙하에 의해 침식 -&gt; 이후 물이 차면 피오르"/>
          <d k="현곡" v="지류빙하는 본류빙하보다 약해서 덜파임"/>
          <li c="1">다 파이고나서 보면 위에 걸려있음 =&gt; 폭포형성됨 (수력발전에 유리)</li>
          <note>노르웨이가 대표적이다</note>
        </group>
        <group title="퇴적 지형">
          <d k="모레인(빙퇴석)" v="빙하 테두리 따라 밀려온 것(분급X) -&gt; 앞에있는게 더 이름"/>
          <d k="드럼린" v="부딪히는 쪽이 급사면, 집단적 분포, 숟가락 엎은 모양"/>
          <d k="에스커" v="융빙수 퇴적 -&gt; 분급양호, 제방모양"/>
          <d k="빙력토 평원" v="빙하 퇴적물이 있는 평원 -&gt; 평평해서 물이 자주 고여 습지 多"/>
        </group>
        <group title="기타 — 빙하호">
          <li>빙하 녹은 물이 고이거나, 빙하 퇴적물이 하천을 막아 형성 or 권곡호</li>
          <note>오대호는 대표적인 빙하호이다.</note>
        </group>
      </group>
      <group title="주빙하 지형">
        <li>툰드라 기후에서 주로 나타남</li>
        <li>결빙과 융해 반복 -&gt; 지형형성</li>
        <d k="구조토" v="활동층의 결빙과 융해 -&gt; 패턴 (여름에는 물이 고여 거북등 연못)"/>
        <note>활동층은 배수가 불량하다</note>
        <d k="솔리플럭션" v="활동층 -&gt; 여름철 융해되며 활동층 흘러내림(경사지)"/>
        <d k="기계적풍화" v="얼음의 쐐기작용 -&gt; 애추 형성"/>
        <note>바위 고인틈 물이 얼면서 팽창 -&gt; 얼음이 부서져내리며 산사면에서 송곳모양의 애추가 나타남</note>
      </group>
      <q>
        <ask>카르스트 지형을 모두 고르시오.</ask>
        <opt ok="1">우발라</opt>
        <opt ok="1">폴리예</opt>
        <opt ok="1">카렌</opt>
        <opt ok="1">석회화 단구</opt>
        <opt>드럼린</opt>
        <opt>메사</opt>
        <opt>와디</opt>
        <opt>에스커</opt>
        <opt>삼릉석</opt>
        <why>석회암의 용식으로 생긴 것들. 드럼린·에스커는 빙하, 메사·와디는 건조 지형.</why>
      </q>
      <q>
        <ask>카르스트 지형이 나타나는 곳을 모두 고르시오.</ask>
        <opt ok="1">중국 구이린</opt>
        <opt ok="1">베트남 하롱베이</opt>
        <opt ok="1">필리핀 초콜릿 힐스</opt>
        <opt ok="1">마다가스카르 칭기</opt>
        <opt>미국 모뉴먼트 밸리</opt>
        <opt>미국 옐로스톤</opt>
        <opt>노르웨이 게이랑에르</opt>
        <why>모뉴먼트 밸리는 메사·뷰트, 옐로스톤은 화산, 게이랑에르는 피오르.</why>
      </q>
      <q>
        <ask>빙하가 만든 지형을 모두 고르시오.</ask>
        <opt ok="1">피오르</opt>
        <opt ok="1">호른</opt>
        <opt ok="1">드럼린</opt>
        <opt ok="1">오대호</opt>
        <opt>애추</opt>
        <opt>구조토</opt>
        <opt>돌리네</opt>
        <opt>와디</opt>
        <why>애추·구조토는 빙하가 아닌 얼고 녹기(주빙하), 돌리네는 석회암 용식, 와디는 건조 지형.</why>
      </q>
      <q>
        <ask>분급이 양호한 퇴적 지형을 모두 고르시오.</ask>
        <opt ok="1">에스커</opt>
        <opt ok="1">사구</opt>
        <opt>모레인</opt>
        <opt>빙력토 평원</opt>
        <opt>선상지</opt>
        <opt>애추</opt>
        <why>물이나 바람이 실어 나르면 알갱이 크기가 고르다. 빙하가 직접 밀어 쌓은 모레인·빙력토, 곡구에 쏟아 놓은 선상지, 굴러떨어진 애추는 뒤섞여 있다.</why>
      </q>
      <q>
        <ask>건조 지형 가운데 물(유수)이 만든 것을 모두 고르시오.</ask>
        <opt ok="1">와디</opt>
        <opt ok="1">플라야</opt>
        <opt ok="1">선상지</opt>
        <opt ok="1">메사</opt>
        <opt>사구</opt>
        <opt>버섯바위</opt>
        <opt>삼릉석</opt>
        <opt>사막 포도</opt>
        <why>바람이 만든 것은 사구·버섯바위·삼릉석·사막 포도.</why>
      </q>
      <q>
        <ask>주빙하 지형을 모두 고르시오.</ask>
        <opt ok="1">구조토</opt>
        <opt ok="1">솔리플럭션</opt>
        <opt ok="1">애추</opt>
        <opt>드럼린</opt>
        <opt>에스커</opt>
        <opt>카렌</opt>
        <why>얼고 녹기를 되풀이해 생긴다. 드럼린·에스커는 빙하가 직접(또는 녹은 물이) 만든 것.</why>
      </q>
    </section>
  </part>
