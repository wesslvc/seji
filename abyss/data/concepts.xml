<?xml version="1.0" encoding="UTF-8"?>
<!-- 세계지리 지엽개념 정리 — tools/restructure-codex.py 가 만든다.
     내용은 사용자가 쓴 정리본 그대로이고, 뼈대(대단원·묶음·정의표)만 다시 짰다. -->
<codex title="세계지리 지엽개념" v="2" status="draft">
  <part id="region" title="지역과 문화" desc="권역·문명·지역화 전략처럼 자리를 외워 두는 것들">
    <section n="1" title="구소련 국가들(15개국)">
      <li>발트3국, 캅카스3국, 중앙아시아 5개국, 러시아, 우크라이나, 벨라루스, 몰도바</li>
    </section>
    <section n="2" title="인도네시아의 종교명소">
      <d k="자바섬" v="보로부두르 사원 (불교)"/>
      <d k="발리섬" v="힌두교"/>
    </section>
    <section n="3" title="중남미 문명">
      <d k="마야" v="멕시코 남부(치아파스 주 이남) ~ 온두라스 &amp; 엘살바도르"/>
      <d k="아즈텍" v="멕시코 중부(멕시코시티 – 당시 테노치티틀란)"/>
      <d k="잉카" v="페루(수도 쿠스코), 에콰도르, 볼리비아 칠레 북부, 콜롬비아남부, 아르헨티나 북서부 등"/>
      <figure src="img/codex/image1.webp" caption="마야·아즈텍·잉카 문명의 분포"/>
      <q a="마야">
        <ask>「중남미 문명」 — 멕시코 남부(치아파스 주 이남) ~ 온두라스 &amp; 엘살바도르</ask>
        <opt>마야</opt>
        <opt>아즈텍</opt>
        <opt>잉카</opt>
      </q>
      <q a="아즈텍">
        <ask>「중남미 문명」 — 멕시코 중부(멕시코시티 – 당시 테노치티틀란)</ask>
        <opt>아즈텍</opt>
        <opt>마야</opt>
        <opt>잉카</opt>
      </q>
      <q a="잉카">
        <ask>「중남미 문명」 — 페루(수도 쿠스코), 에콰도르, 볼리비아 칠레 북부, 콜롬비아남부, 아르헨티나 북서부 등</ask>
        <opt>잉카</opt>
        <opt>마야</opt>
        <opt>아즈텍</opt>
      </q>
    </section>
    <section n="4" title="지역화 전략들">
      <d k="지리적표시제" v="지적재산권"/>
      <d k="장소마케팅" v="축제 (태국 송끄란 -&gt; 건기끝나는시기에)"/>
      <d k="지역브랜드화" v="상표"/>
      <q a="지리적표시제">
        <ask>「지역화 전략들」 — 지적재산권</ask>
        <opt>지리적표시제</opt>
        <opt>장소마케팅</opt>
        <opt>지역브랜드화</opt>
      </q>
      <q a="장소마케팅">
        <ask>「지역화 전략들」 — 축제 (태국 송끄란 -&gt; 건기끝나는시기에)</ask>
        <opt>장소마케팅</opt>
        <opt>지리적표시제</opt>
        <opt>지역브랜드화</opt>
      </q>
      <q a="지역브랜드화">
        <ask>「지역화 전략들」 — 상표</ask>
        <opt>지역브랜드화</opt>
        <opt>지리적표시제</opt>
        <opt>장소마케팅</opt>
      </q>
    </section>
  </part>
  <part id="map" title="지도와 지리 정보" desc="고지도 계보, 지리 정보의 종류와 수집 방법">
    <section n="5" title="서양의 고지도">
      <group title="프톨레마이오스 지도 (AD)" i="1">
        <li>지구가 구체임을 인식(경위선 사용)</li>
        <li>원뿔도법</li>
        <li>인도양 내해(內海)로 표현함(수특에도 있는 내용)</li>
        <figure src="img/codex/image2.webp" caption="프톨레마이오스 세계지도"/>
      </group>
      <group title="TO지도" i="2">
        <li>아시아 아프리카 경계는 홍해</li>
        <li>유럽 아시아 경계는 지중해</li>
        <li>아시아 유럽 경계는 타나이스(돈강)</li>
        <note>(돈강은 모스크바, 우크라이나 일대를 지난다)</note>
        <figure src="img/codex/image3.webp" caption="TO 지도"/>
      </group>
      <group title="마파문디" i="3">
        <figure src="img/codex/image4.webp" caption="마파문디"/>
      </group>
      <group title="알 이드리시 세계지도" i="4">
        <li>메카를 중심에 둠 (그러려고 뒤집음)</li>
        <li>지구를 구체로 인식 (등기후선을 곡선으로 그림)</li>
        <figure src="img/codex/image5.webp" caption="알 이드리시 세계지도"/>
      </group>
      <group title="포르톨라노 해도海圖" i="5">
        <li>향해용 지도</li>
        <li>항구와 섬을 자세히 표현</li>
        <li>나침반에서 여러개의 방사선 -&gt; 항로파악</li>
        <figure src="img/codex/image6.webp" caption="포르톨라노 해도"/>
      </group>
      <group title="메르카토르" i="6">
        <li>신대륙 그려져있음</li>
        <d k="원통 도법" v="방위가 정확함"/>
        <d k="직선" v="등각항로(최단거리X)"/>
        <li>고위도로 갈수록 면적확대</li>
        <note>면적 확대의 이유는 실제로 위도가 올라갈수록 경선간 간격이 감소하는데 북극점, 남극점을 중심으로 펼치다보니 경산간 간격이 적도부터 고위도까지 모두 일치하게 되었기에 왜곡이 발생함</note>
        <figure src="img/codex/image7.webp" caption="메르카토르 세계지도 (1569)"/>
      </group>
    </section>
    <section n="6" title="우리나라의 고지도">
      <group title="혼일강리역대국도지도 (1402)" i="1">
        <li>중화사상 반영</li>
        <li>구대륙 ∀반영</li>
        <li>천원지방</li>
        <note>대명혼일도와 굳이 구분하자면 한자의 길이, 우리나라의 크기로 구분가능</note>
        <note>대명혼일도와 굳이 구분하자면22 대명혼일도가 먼저임</note>
        <figure src="img/codex/image8.webp" caption="혼일강리역대국도지도 (1402)"/>
      </group>
      <group title="천하도 (조선 중기)" i="2">
        <li>민간에서 제작</li>
        <li>중화사상</li>
        <li>내대륙 현실 / 외대륙 상상 (=&gt; 도교사상반영)</li>
        <li>천원지방</li>
        <figure src="img/codex/image9.webp" caption="천하도"/>
      </group>
      <group title="지구전후도" i="3">
        <li>민간에서 제작</li>
        <li>중화사상 &amp; 천원지방X</li>
        <li>지구를 구체로 인식 (경위선, 회귀선O)</li>
        <d k="목판본" v="대량생산"/>
        <figure src="img/codex/image10.webp" caption="지구전후도"/>
      </group>
    </section>
    <section n="7" title="중국의 고지도">
      <group title="화이도 (송나라 12세기)" i="1">
        <li>중국 전체가 표현된 현존 가장 오래된 지도</li>
        <li>천원지방</li>
        <li>중화사상 (중국 확대, 타 지역 축소)</li>
        <figure src="img/codex/image11.webp" caption="화이도"/>
      </group>
      <group title="대명혼일도 (14세기 末)" i="2">
        <li>천원지방</li>
        <li>중화사상</li>
        <figure src="img/codex/image12.webp" caption="대명혼일도"/>
      </group>
      <group title="곤여만국전도 (17세기 초)" i="3">
        <li>마테오리치(ITA) + 明 학자</li>
        <li>태평양을 중앙에 배치</li>
        <li>중화사상 &amp; 천원지방 OUT</li>
        <li>지구를 구체로 인식</li>
        <figure src="img/codex/image13.webp" caption="곤여만국전도"/>
      </group>
    </section>
    <section n="8" title="지리정보">
      <d k="공간정보" v="수리적 위치 &amp; 모양"/>
      <d k="관계정보" v="다른 장소의 이름과 함께 제시됨(수교 등)"/>
      <d k="속성" v="(공간U관계)^c"/>
      <q a="공간정보">
        <ask>「지리정보」 — 수리적 위치 &amp; 모양</ask>
        <opt>공간정보</opt>
        <opt>관계정보</opt>
        <opt>속성</opt>
      </q>
      <q a="관계정보">
        <ask>「지리정보」 — 다른 장소의 이름과 함께 제시됨(수교 등)</ask>
        <opt>관계정보</opt>
        <opt>공간정보</opt>
        <opt>속성</opt>
      </q>
      <q a="속성">
        <ask>「지리정보」 — (공간U관계)^c</ask>
        <opt>속성</opt>
        <opt>공간정보</opt>
        <opt>관계정보</opt>
      </q>
    </section>
    <section n="12" title="지리정보 수집방법">
      <d k="직접조사" v="가서"/>
      <d k="원격조사" v="위성이나 드론으로"/>
      <d k="간접조사" v="인터넷, 문헌"/>
      <q a="직접조사">
        <ask>「지리정보 수집방법」 — 가서</ask>
        <opt>직접조사</opt>
        <opt>원격조사</opt>
        <opt>간접조사</opt>
      </q>
      <q a="원격조사">
        <ask>「지리정보 수집방법」 — 위성이나 드론으로</ask>
        <opt>원격조사</opt>
        <opt>직접조사</opt>
        <opt>간접조사</opt>
      </q>
      <q a="간접조사">
        <ask>「지리정보 수집방법」 — 인터넷, 문헌</ask>
        <opt>간접조사</opt>
        <opt>직접조사</opt>
        <opt>원격조사</opt>
      </q>
    </section>
    <section n="13" title="GPS VS GIS">
      <d k="GPS" v="Global Positioning System =&gt; 위치정보 수집"/>
      <d k="GIS" v="Geographic Information System =&gt; 분석 &amp; 시각화"/>
    </section>
    <section n="14" title="권역구분">
      <d k="자연적지표" v="기후, 식생, 토양, 지표, 자연 등"/>
      <d k="문화적 지표" v="언어, 종교, 음식 등 (애매하고 복잡)"/>
      <d k="기능적 지표" v="행정권, 생활권, 교통권 등 (ex 수도권)"/>
      <q a="자연적지표">
        <ask>「권역구분」 — 기후, 식생, 토양, 지표, 자연 등</ask>
        <opt>자연적지표</opt>
        <opt>문화적 지표</opt>
        <opt>기능적 지표</opt>
      </q>
      <q a="문화적 지표">
        <ask>「권역구분」 — 언어, 종교, 음식 등 (애매하고 복잡)</ask>
        <opt>문화적 지표</opt>
        <opt>자연적지표</opt>
        <opt>기능적 지표</opt>
      </q>
      <q a="기능적 지표">
        <ask>「권역구분」 — 행정권, 생활권, 교통권 등 (ex 수도권)</ask>
        <opt>기능적 지표</opt>
        <opt>자연적지표</opt>
        <opt>문화적 지표</opt>
      </q>
    </section>
  </part>
  <part id="coord" title="위치와 시간" desc="위선·경선·시차, 그리고 태양 고도가 만드는 낮과 밤">
    <section n="9" title="시차 계산">
      <d k="동경" v="GMT + -&gt; 시간 빠름"/>
      <d k="서경" v="GMT - -&gt; 시간 느림"/>
      <li c="1">15°당 1시간</li>
    </section>
    <section n="10" title="주요 위선">
      <d k="0°" v="적도기니 케냐 싱가포르 에콰도르"/>
      <note>사실 적도기니는 적도보다 아주 살짝 북쪽에 있어 지나지 않음 즉 가봉과 DRC가 적도를 지나는 것</note>
      <d k="23.5°N" v="서사하라, UAE, 대만, 캘리포니아반도 끝"/>
      <d k="23.5°S" v="나미비아, 호주관통, 남미 접선"/>
      <q a="0°">
        <ask>「주요 위선」 — 적도기니 케냐 싱가포르 에콰도르</ask>
        <opt>0°</opt>
        <opt>23.5°N</opt>
        <opt>23.5°S</opt>
      </q>
      <q a="23.5°N">
        <ask>「주요 위선」 — 서사하라, UAE, 대만, 캘리포니아반도 끝</ask>
        <opt>23.5°N</opt>
        <opt>0°</opt>
        <opt>23.5°S</opt>
      </q>
      <q a="23.5°S">
        <ask>「주요 위선」 — 나미비아, 호주관통, 남미 접선</ask>
        <opt>23.5°S</opt>
        <opt>0°</opt>
        <opt>23.5°N</opt>
      </q>
    </section>
    <section n="11" title="주요 경선">
      <d k="120°W" v="LA, SF"/>
      <d k="75°W" v="NY, DC"/>
      <d k="0°" v="영국 &amp; 기니만"/>
      <d k="75°E" v="인도관통"/>
      <d k="120°E" v="북경, 호주서부"/>
      <q a="120°W">
        <ask>「주요 경선」 — LA, SF</ask>
        <opt>120°W</opt>
        <opt>75°W</opt>
        <opt>0°</opt>
        <opt>75°E</opt>
      </q>
      <q a="75°W">
        <ask>「주요 경선」 — NY, DC</ask>
        <opt>75°W</opt>
        <opt>120°W</opt>
        <opt>0°</opt>
        <opt>75°E</opt>
      </q>
      <q a="0°">
        <ask>「주요 경선」 — 영국 &amp; 기니만</ask>
        <opt>0°</opt>
        <opt>120°W</opt>
        <opt>75°W</opt>
        <opt>75°E</opt>
      </q>
      <q a="75°E">
        <ask>「주요 경선」 — 인도관통</ask>
        <opt>75°E</opt>
        <opt>120°W</opt>
        <opt>75°W</opt>
        <opt>0°</opt>
      </q>
      <q a="120°E">
        <ask>「주요 경선」 — 북경, 호주서부</ask>
        <opt>120°E</opt>
        <opt>120°W</opt>
        <opt>75°W</opt>
        <opt>0°</opt>
      </q>
    </section>
    <section n="18" title="정오의 태양고도각">
      <li>태양 고도각이 90도인 지점으로부터 거리에 반비례</li>
    </section>
    <section n="19" title="백야와 극야">
      <li>부분 백/극야 (48~66.5도) - 박명(Twilight)이 이어져 초저녁같음</li>
      <li>백/극야 (66.5도↑) - 자정에도 태양이 수평선보다 높게 떠있음</li>
    </section>
    <section n="20" title="낮길이">
      <d k="하지" v="90°N = 24시간 -&gt; 90°S 0시간"/>
      <d k="동지" v="90°S = 24시간 / 90°N 0시간"/>
      <d k="춘/추분" v="전지구 낮길이 동일(12시간)"/>
      <q a="하지">
        <ask>「낮길이」 — 90°N = 24시간 -&gt; 90°S 0시간</ask>
        <opt>하지</opt>
        <opt>동지</opt>
        <opt>춘/추분</opt>
      </q>
      <q a="동지">
        <ask>「낮길이」 — 90°S = 24시간 / 90°N 0시간</ask>
        <opt>동지</opt>
        <opt>하지</opt>
        <opt>춘/추분</opt>
      </q>
      <q a="춘/추분">
        <ask>「낮길이」 — 전지구 낮길이 동일(12시간)</ask>
        <opt>춘/추분</opt>
        <opt>하지</opt>
        <opt>동지</opt>
      </q>
    </section>
  </part>
  <part id="climate" title="기후" desc="기후 요소부터 쾨펜 구분, 기후별 농업·식생·토양·가옥까지">
    <section n="15" title="계절풍">
